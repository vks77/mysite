    <!-- TEXT SVG -->
    <!-- Generator: https://danmarshall.github.io/google-font-to-svg-path/ -->
    <!-- Google font: Great Vibes -->
    <svg
      width="160"
      height="70"
      viewBox="0 0 800 150"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <style>
          /* @import url('https://fonts.googleapis.com/css2?family=Rozha+One&display=swap'); */
          @font-face {
            font-family: 'Rozha One';
            /* Add other properties here, as needed. For example: */
            /*
            font-weight: 100 900;
            font-style: normal italic;
            */
            src: url(data:font/woff2;base64,);
          }
        </style>

        <!-- Royal Gold Gradient -->
        <linearGradient id="goldAnimated" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#C6A75E"></stop>
          <stop offset="50%" stop-color="#FFD700"></stop>
          <stop offset="100%" stop-color="#B8860B"></stop>
        </linearGradient>

        <!-- Subtle Glow -->
        <filter id="softGlow">
          <feGaussianBlur stdDeviation="2" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <text
        x="50%"
        y="55%"
        text-anchor="middle"
        font-family="'Rozha One', serif"
        font-size="48"
        fill="url(#goldAnimated)"
        fill-opacity="0"
        stroke="url(#goldAnimated)"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        transform="skewX(-8)"
        filter="url(#softGlow)"
        stroke-dasharray="650"
        stroke-dashoffset="650"
        aria-hidden="true"
      >
        <!-- Draw animation -->
        <animate
          attributeName="stroke-dashoffset"
          from="650"
          to="0"
          dur="2s"
          fill="freeze"></animate>

        <!-- Fill fade -->
        <animate
          attributeName="fill-opacity"
          from="0"
          to="1"
          begin="1.6s"
          dur="0.6s"
          fill="freeze"></animate>

        <!-- Gentle pulse glow -->
        <animate
          attributeName="stroke-width"
          values="1.6;1.9;1.6"
          dur="2.5s"
          begin="2.2s"
          repeatCount="indefinite"></animate>

        विनय शर्मा
      </text>
    </svg>
  </div>
</Link>

<style>
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;

    transform: scale(1.05);
  }

  @media (prefers-reduced-motion) {
    path {
      animation: none !important;
      stroke-dasharray: unset !important;
    }
  }
  @keyframes grow {
    0% {
      stroke-dashoffset: 1px;
      stroke-dasharray: 0 350px;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    40% {
      stroke-dasharray: 350px 0;
    }
    /* Moving back */
    85% {
      stroke-dasharray: 350px 0;
    }
    95%,
    to {
      stroke-dasharray: 0 350px;
    }
  }
  path {
    stroke-dashoffset: 1px;
    stroke-dasharray: 350px 0;
    animation: grow 10s ease forwards infinite;
    transform-origin: center;
    stroke: #303030;
    animation-delay: 0s;
  }

  .logo-container svg {
    height: fit-content;
  }
</style>
